{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist/types",
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true
  },
  "include": [
    "AiClient.ts",
    "types.ts",
    "profiles/**/*.ts",
    "adapters/**/*.ts",
    "index.ts"
  ]
}
