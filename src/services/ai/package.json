{
  "name": "@koreancenter/ai-engine-core",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild index.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/index.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2"
  }
}
